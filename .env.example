# Copy to .env and fill in from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VAT rate applied at checkout (PH VAT = 0.12). Prices are treated as VAT-inclusive.
VITE_VAT_RATE=0.12
VITE_STORE_NAME=My Auto Supply
VITE_STORE_ADDRESS=Lipa City, Batangas
